generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdmissionEnquiry {
  id          String   @id @default(cuid())
  studentName String
  parentName  String
  phone       String
  email       String?
  className   String
  message     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  subject   String?
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model Certificate {
  id            String   @id @default(cuid())
  certificateNo String   @unique
  studentName   String
  className     String
  course        String?
  issueDate     DateTime
  documentHash  String?
  isValid       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([studentName])
}

model ClassFee {
  id            String   @id @default(cuid())
  className     String
  description   String?
  admissionFee  Float    @default(0)
  monthlyFee    Float    @default(0)
  annualFee     Float    @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished])
}
